# Copy this file to ".env" and fill in real values. Never commit ".env" itself.

# --- AI provider (choose one) ------------------------------------------------
# Supported values: anthropic, openai
AI_PROVIDER=anthropic

# API key for the selected provider. Required.
AI_API_KEY=

# Model name for the selected provider. Optional - each provider has a
# sensible default (see ai_service.py) if left blank. The model MUST support
# image/vision input - it is used exclusively for photo captioning
# (claude-sonnet-4-5 and gpt-4o-mini both do; a future Gemini provider would
# need a vision-capable Gemini model too).
# Examples: claude-sonnet-4-5 (anthropic), gpt-4o-mini (openai)
AI_MODEL=

# Per-request timeout (seconds) and retry count for AI calls.
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# --- Photo analysis (optional) -----------------------------------------------
# Leave empty (default) to disable automatic crop suggestions entirely.
# "heuristic" enables a simple, content-agnostic centered-crop suggestion
# (never inspects/interprets what is depicted in the photo).
IMAGE_ANALYSIS_PROVIDER=

# --- Photo processing ---------------------------------------------------------
PHOTO_MAX_DIMENSION_PX=1600
PHOTO_PREVIEW_MAX_DIMENSION_PX=480
PHOTO_JPEG_QUALITY=88
PHOTO_GRID_COLUMNS=2
MAX_PHOTO_FILE_SIZE_MB=25

# --- Photo-appendix layout ----------------------------------------------------
# Photos per appendix page (grouped deterministically, with a forced page
# break between groups, so each page's photos always stay with their own
# caption block).
PHOTOS_PER_APPENDIX_PAGE=4
# Image size relative to the available column width, the gutter between
# neighbouring photos, and the size of the number printed beside each photo.
PHOTO_IMAGE_SCALE=0.88
PHOTO_GUTTER_MM=8
PHOTO_NUMBER_FONT_PT=14

# --- Page-count automation (requires Microsoft Word installed) ---------------
# Uses MS Word COM automation (word_page_counter.py) to compute the real,
# rendered total page count and photo-appendix page count. If disabled (or if
# Word automation fails), the report is still generated, with "-" shown
# instead of the page numbers.
PAGE_COUNT_AUTOMATION_ENABLED=1
PAGE_COUNT_MAX_ATTEMPTS=3
