# Copy this file to ".env" and fill in real values. Never commit ".env" itself.

# --- AI provider (choose one) ------------------------------------------------
# Supported values: anthropic, openai
AI_PROVIDER=anthropic

# API key for the selected provider. Required.
AI_API_KEY=

# Model name for the selected provider. Optional - each provider has a
# sensible default (see ai_service.py) if left blank.
# Examples: claude-sonnet-4-5 (anthropic), gpt-4o-mini (openai)
AI_MODEL=

# Per-request timeout (seconds) and retry count for AI calls.
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# --- Photo analysis (optional) -----------------------------------------------
# Leave empty (default) to disable automatic crop suggestions entirely.
# "heuristic" enables a simple, content-agnostic centered-crop suggestion
# (never inspects/interprets what is depicted in the photo).
IMAGE_ANALYSIS_PROVIDER=

# --- Photo processing ---------------------------------------------------------
PHOTO_MAX_DIMENSION_PX=1600
PHOTO_PREVIEW_MAX_DIMENSION_PX=480
PHOTO_JPEG_QUALITY=88
PHOTO_GRID_COLUMNS=2
MAX_PHOTO_FILE_SIZE_MB=25
